# ── MongoDB ────────────────────────────────────────────────────────────────────
# Paste your Atlas connection string here (replace <username> and <password>).
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# ── Flask ──────────────────────────────────────────────────────────────────────
# Any long random string. Used to sign session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# ── Admin panel ────────────────────────────────────────────────────────────────
# Password required to access /admin
ADMIN_PASSWORD=admin1234

# ── Unsplash (optional) ────────────────────────────────────────────────────────
# Free API key from https://unsplash.com/developers
# If left empty the app falls back to picsum.photos placeholders.
UNSPLASH_ACCESS_KEY=

# ── Email / Flask-Mail (optional) ──────────────────────────────────────────────
# Required only if you want transactional emails (verification, order confirmation).
# Example below uses Gmail with an App Password (2FA must be enabled).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=you@gmail.com
